{
  "schemaVersion": "expert-config/1.0",
  "mode": "expert",
  "pack": "robot-idiot-expert-laboratory-v1",
  "availability": {
    "entryPoint": "home.ExpertLaboratory",
    "requiresAdventureCompletion": false,
    "separateProgressFromAdventure": true
  },
  "navigation": {
    "initialRoute": "expert.tutorial.ifNeeded -> expert.currentSimulation",
    "showWorldMap": false,
    "showLevelSelection": false,
    "showInternalSequenceNumbers": false,
    "resumeCTA": "Continuer l’entraînement",
    "replayRoute": "expert.history",
    "helpRoute": "expert.tutorial.replay"
  },
  "progression": {
    "totalSimulations": 40,
    "completionPercent": "floor(100 * uniqueCompleted / 40)",
    "unlockNextWith": "victory and starRating >= 1",
    "allowReplay": true,
    "allowSkipSimulation": false,
    "finalAchievement": "Laboratoire maîtrisé",
    "postCompletion": "Replay and improve; no infinite generated puzzles"
  },
  "controls": {
    "primitiveCommandsAvailableFromStart": [
      "AVANCE",
      "RECULE",
      "TOURNE_GAUCHE",
      "TOURNE_DROITE",
      "RAMASSE",
      "UTILISE",
      "POUSSE",
      "ACTIVE"
    ],
    "REPETE": {
      "unlockAt": "EX-001",
      "repeatCount": "infinite"
    },
    "SI": {
      "unlockAt": "EX-009",
      "conditionsUnlockBySimulation": {
        "OBSTACLE_DEVANT": "EX-009",
        "CLE_ICI": "EX-017",
        "CADENAS_DEVANT": "EX-017",
        "SUR_BOUTON": "EX-021",
        "CAISSE_DEVANT": "EX-030"
      }
    },
    "unavailableBeforeUnlock": "visible, locked, disabled; never runnable"
  },
  "stars": {
    "metric": "writtenBlocks",
    "countASTNodesOnce": true,
    "countSIOncePlusBodyNodes": true,
    "countREPETEOncePlusBodyNodes": true,
    "countVisualEndMarkers": false,
    "compareOnVictoryOnly": true,
    "oneStarAnyWin": true,
    "twoStarReferenceThreshold": "starTargets.twoStarsMax",
    "threeStarReferenceThreshold": "starTargets.threeStarsMax",
    "noArbitraryBlocksLimit": true,
    "noImpactToAdventureScoring": "executedPrimitiveActions"
  },
  "persistence": {
    "namespace": "robotIdiot.expert.v1",
    "bestStarsBySimulation": "starRating by EX-id",
    "bestWrittenBlocks": "minimum winning block count by EX-id",
    "savedProgramBySimulation": "AST encoded per EX-id",
    "nextAvailableId": "first not yet completed",
    "tutorialCompletedKey": "robotIdiot.expert.tutorial.v1.completed",
    "neverOverwriteAdventureKeys": true,
    "neverOverwriteDailyKeys": true,
    "atomicSaveRecommended": true
  },
  "runtimeSafety": {
    "maxExecutedPrimitiveActions": 1000,
    "maxASTNodes": null,
    "maxInterpretationSteps": 20000,
    "maxWallTimeSeconds": 20,
    "controlFeedback": "Show why stopped without deleting editor program"
  },
  "assets": {
    "reuseExistingRobotAndTiles": true,
    "reuseVisualThemesFromAdventure": true,
    "newGraphicsRequired": false,
    "worldVisualThemeIsOnlyStyling": true
  },
  "dataValidation": {
    "allProgramsReplayedOffline": true,
    "minimumWrittenBlocksProven": false,
    "minimumPrimitiveCommandsOfflineBFSProven": true,
    "swiftReplayRequired": true
  },
  "sourceFiles": [
    "robot_idiot_expert_simulations_40.json",
    "robot_idiot_expert_tutorial_fr.json"
  ]
}
